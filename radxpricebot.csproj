<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Enable both WPF and WinForms assemblies -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Declare the RID you’re publishing for -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- App metadata -->
    <ApplicationIcon>radxpb.ico</ApplicationIcon>
    <Title>Rad-X Price Bot</Title>
    <PackageIcon>Radxpb.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <WarningLevel>1</WarningLevel>
  </PropertyGroup>

  <!-- remove any hard-coded References to System.Windows.Forms/System.Drawing—
       the SDK will auto-include them now that UseWindowsForms is true -->

  <ItemGroup>
    <Compile Remove="Resources\**" />
    <EmbeddedResource Remove="Resources\**" />
    <None Remove="Resources\**" />
    <Page Remove="Resources\**" />
  </ItemGroup>

  <!-- COMReference entries removed entirely -->

  <ItemGroup>
    <Content Include="radxpb.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.17.4" />
    <PackageReference Include="Nethereum.Util" Version="4.29.0" />
    <PackageReference Include="Nethereum.Web3" Version="4.29.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ChatGPT Image Apr 29, 2025, 06_28_27 PM.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="Radxpb.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
