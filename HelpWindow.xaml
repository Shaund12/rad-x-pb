<!-- HelpWindow.xaml -->
<Window x:Class="RadXPriceBot.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadXPriceBot"
        mc:Ignorable="d"
        Title="Help"
        Height="650" Width="800"
        Background="{StaticResource PanelBgBrush}"
        Foreground="{StaticResource PrimaryBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#292930" TargetName="border"/>
                                <Setter Property="BorderBrush" Value="#3A3A45" TargetName="border"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E1E24" TargetName="border"/>
                                <Setter Property="BorderBrush" Value="#3A3A45" TargetName="border"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
            <Setter Property="Foreground" Value="#5CDBF0"/>
        </Style>

        <Style x:Key="SubHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#91F5AD"/>
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="#25252D"/>
            <Setter Property="BorderBrush" Value="#3A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#25252D"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                <TextBlock x:Name="WatermarkText" 
                                          Text="Search..." 
                                          Foreground="#777777" 
                                          Margin="{TemplateBinding Padding}"
                                          Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#5CDBF0" TargetName="border"/>
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Visible" TargetName="WatermarkText"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#5CDBF0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock TextDecorations="Underline" 
                                  Text="{TemplateBinding Content}" 
                                  Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2F80ED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4C8FED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1F70DD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <Border Grid.Column="0" 
                Background="#1A1A20" 
                BorderBrush="#2D2D35" 
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" 
                        Background="#232329" 
                        Padding="15,20">
                    <StackPanel>
                        <TextBlock Text="RadX Price Bot" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock x:Name="VersionTextBlock" 
                                   Text="v1.0.0" 
                                   FontSize="12" 
                                   Margin="0,5,0,0" 
                                   Foreground="#888888"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" 
                              Margin="0,10,0,0" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,0">
                        <!-- Search Box -->
                        <TextBox x:Name="SearchBox" 
                                 Style="{StaticResource SearchBoxStyle}" 
                                 Margin="0,0,0,10" 
                                 KeyUp="SearchBox_KeyUp"/>

                        <!-- Documentation Section -->
                        <TextBlock Text="DOCUMENTATION" 
                                   FontSize="12" 
                                   Margin="5,5,0,5" 
                                   Foreground="#888888"/>

                        <Button Content="Getting Started" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="getting-started" 
                                Click="NavButton_Click"/>

                        <Button Content="Setup Instructions" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="setup" 
                                Click="NavButton_Click"/>

                        <Button Content="Contract Requirements" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="contracts" 
                                Click="NavButton_Click"/>

                        <Button Content="Bot Configuration" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="configuration" 
                                Click="NavButton_Click"/>

                        <Button Content="Discord Integration" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="discord" 
                                Click="NavButton_Click"/>

                        <!-- FAQ Section -->
                        <TextBlock Text="FAQ" 
                                   FontSize="12" 
                                   Margin="5,15,0,5" 
                                   Foreground="#888888"/>

                        <Button Content="General Questions" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="faq-general" 
                                Click="NavButton_Click"/>

                        <Button Content="Technical Questions" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="faq-technical" 
                                Click="NavButton_Click"/>

                        <Button Content="Troubleshooting" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="troubleshooting" 
                                Click="NavButton_Click"/>

                        <!-- About Section -->
                        <TextBlock Text="ABOUT" 
                                   FontSize="12" 
                                   Margin="5,15,0,5" 
                                   Foreground="#888888"/>

                        <Button Content="About RadX Price Bot" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="about" 
                                Click="NavButton_Click"/>

                        <Button Content="Technologies Used" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="technologies" 
                                Click="NavButton_Click"/>

                        <Button Content="License" 
                                Style="{StaticResource NavButtonStyle}" 
                                Tag="license" 
                                Click="NavButton_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" 
                        Background="#232329" 
                        Padding="15,15">
                    <StackPanel>
                        <TextBlock Text="Need more help?" 
                                   FontSize="12" 
                                   Foreground="#888888"/>
                        <Button Content="Visit GitHub Repository" 
                                Style="{StaticResource LinkButtonStyle}" 
                                Margin="0,5,0,0"
                                Click="VisitRepo_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Content Display -->
            <ScrollViewer Grid.Row="0" 
                          Margin="20"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="ContentTitleBlock" 
                               Text="Documentation" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Margin="0,0,0,20" 
                               Foreground="{StaticResource PrimaryBrush}"/>

                    <!-- Rich Content Area -->
                    <RichTextBox x:Name="ContentRichTextBox" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 IsReadOnly="True" 
                                 IsDocumentEnabled="True" 
                                 Foreground="{StaticResource PrimaryBrush}">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0,0,0,10"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>

                    <!-- For compatibility, keep the original TextBlock but hide it -->
                    <TextBlock x:Name="ContentTextBlock" 
                               TextWrapping="Wrap" 
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Button Area -->
            <Border Grid.Row="1" 
                    Background="#232329" 
                    BorderBrush="#2D2D35" 
                    BorderThickness="0,1,0,0" 
                    Padding="20,15">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="Close" 
                            Width="80" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
