<!-- MainWindow.xaml -->
<Window x:Class="RadXPriceBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RadXPriceBot"
        xmlns:conv="clr-namespace:RadXPriceBot.Converters"
        Title="RadX Price Bot"
        Height="770" Width="860"
        Background="{StaticResource PanelBgBrush}"
        Foreground="{StaticResource PrimaryBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:BotRunningConverter x:Key="BotRunningConverter"/>
        <conv:IsCustomStatusConverter x:Key="IsCustomStatusConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverterInverted"></conv:BoolToVisibilityConverter>

        <!-- Expanded Color Palette -->
        <Color x:Key="HeaderBgColor">#FF191A21</Color>
        <Color x:Key="CardBgColor">#FF282A36</Color>
        <Color x:Key="HighlightColor">#FF8BE9FD</Color>
        <Color x:Key="WarningColor">#FFFF79C6</Color>
        <Color x:Key="ErrorColor">#FFFF5555</Color>
        <Color x:Key="OrangeColor">#FFFFB86C</Color>
        <Color x:Key="YellowColor">#FFF1FA8C</Color>

        <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}"/>
        <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}"/>

        <!-- Card Panel Style -->
        <Style x:Key="CardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="10" Opacity="0.4" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HighlightBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Custom Button Styles -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="8">
                            <Grid>
                                <ContentPresenter x:Name="content" 
                                                 HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="content" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="content" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button: Start -->
        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2C3C2F"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A4E3D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action Button: Stop -->
        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#3C2C2C"/>
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Utility Button -->
        <Style x:Key="UtilityButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2C2C3C"/>
            <Setter Property="Foreground" Value="{StaticResource HighlightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A4E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1B23"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404452"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" 
                              Margin="5,0,0,0" 
                              ContentSource="Content"
                              VerticalAlignment="Center" />
                    <Path x:Name="Arrow" 
                  Grid.Column="1"
                  Data="M 0,0 L 4,4 L 8,0 Z" 
                  Fill="{StaticResource PrimaryBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#1A1B23"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Arrow" Property="Fill" Value="#666666"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style -->
        <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" 
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#30FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style with Black Background and Green Text -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F1015"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404452"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                  ClickMode="Press"
                                  Focusable="False"
                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Template="{StaticResource ComboBoxToggleButtonTemplate}"/>
                            <ContentPresenter x:Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                    Background="#0F1015"
                                    BorderBrush="#404452"
                                    BorderThickness="1"
                                    CornerRadius="0,0,5,5"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ElementName=ToggleButton, Path=ActualWidth}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="True">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GroupBox Style -->
        <Style x:Key="ModernGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" 
                                    Background="#282A36" 
                                    BorderThickness="1,1,1,0" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    Padding="8,5" 
                                    CornerRadius="8,8,0,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>

                            <Border Grid.Row="1" 
                                    Background="#20FFFFFF" 
                                    BorderThickness="1,0,1,1" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    Padding="8" 
                                    CornerRadius="0,0,8,8">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl Style -->
        <Style x:Key="ModernTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" 
                                    Background="{StaticResource HeaderBgBrush}" 
                                    BorderThickness="0,0,0,1" 
                                    BorderBrush="#404452" 
                                    CornerRadius="0">
                                <TabPanel x:Name="HeaderPanel" 
                                          Panel.ZIndex="1" 
                                          Margin="0,0,0,0" 
                                          IsItemsHost="True" 
                                          KeyboardNavigation.TabIndex="1" 
                                          Background="Transparent"/>
                            </Border>

                            <Border Grid.Row="1" 
                                    Background="{StaticResource PanelBgBrush}"
                                    BorderThickness="0"
                                    CornerRadius="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" 
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  Margin="{TemplateBinding Padding}" 
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabItem Style -->
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                BorderThickness="0,0,0,3" 
                                BorderBrush="Transparent" 
                                Background="Transparent"
                                Margin="0">
                            <ContentPresenter x:Name="ContentSite" 
                                              ContentSource="Header" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#20FFFFFF"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{StaticResource HighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="#20FFFFFF"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListView Style -->
        <Style x:Key="ModernListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="#1A1B23"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404452"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <!-- ListViewItem Style -->
        <Style x:Key="ModernListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#404452"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- LogConsole Style -->
        <Style x:Key="LogConsoleStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#10121A"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404452"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                          Padding="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404452"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#10FFFFFF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#20FFFFFF"/>
            <Setter Property="VerticalGridLinesBrush" Value="#20FFFFFF"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource HighlightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" Padding="15,10">
            <DockPanel LastChildFill="False">
                <!-- Logo & App Title -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
                                <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <TextBlock Text="RX" FontWeight="Bold" FontSize="16" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#FF21222C"/>
                    </Border>
                    <TextBlock Text="RadX Price Bot" Foreground="{StaticResource AccentBrush}" 
                       FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- DPI Scaling Selector -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="UI Scale:" 
                      Foreground="{StaticResource HighlightBrush}" 
                      VerticalAlignment="Center" 
                      Margin="0,0,8,0"/>
                    <ComboBox x:Name="DpiScalingComboBox" 
                      Width="70" 
                      Style="{StaticResource ModernComboBoxStyle}"
                      ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"
                      SelectionChanged="DpiScalingComboBox_SelectionChanged">
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="125%"/>
                        <ComboBoxItem Content="150%"/>
                        <ComboBoxItem Content="175%"/>
                        <ComboBoxItem Content="200%"/>
                    </ComboBox>
                </StackPanel>

                <!-- Menu Bar -->
                <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="File" Foreground="{StaticResource PrimaryBrush}" FontSize="14">
                        <MenuItem Header="Settings" Click="MenuItem_Settings_Click" Foreground="{StaticResource PrimaryBrush}">
                            <MenuItem.Icon>
                                <TextBlock Text="⚙️" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Exit" Click="MenuItem_Exit_Click" Foreground="{StaticResource PrimaryBrush}">
                            <MenuItem.Icon>
                                <TextBlock Text="🚪" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Help" Foreground="{StaticResource PrimaryBrush}" FontSize="14" Margin="10,0,0,0">
                        <MenuItem Header="Documentation" Click="MenuItem_Documentation_Click" Foreground="{StaticResource PrimaryBrush}">
                            <MenuItem.Icon>
                                <TextBlock Text="📚" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="FAQ" Click="MenuItem_FAQ_Click" Foreground="{StaticResource PrimaryBrush}">
                            <MenuItem.Icon>
                                <TextBlock Text="❓" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="About" Click="MenuItem_About_Click" Foreground="{StaticResource PrimaryBrush}">
                            <MenuItem.Icon>
                                <TextBlock Text="ℹ️" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" 
                    Style="{StaticResource ModernTabControlStyle}"
                    Background="{StaticResource PanelBgBrush}">

            <!-- Single Bot Tab -->
            <TabItem Header="Single Bot" Style="{StaticResource ModernTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="5,10">
                        <!-- Connection Settings Card -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="CONNECTION SETTINGS" Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Discord Bot Token" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="BotTokenTextBox" 
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Margin="0,0,0,12"/>

                                        <TextBlock Text="Guild ID" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="GuildIdTextBox" 
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Margin="0,0,0,12"/>
                                    </StackPanel>

                                    <!-- Right Column -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="RPC Endpoint URL" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="RpcUrlTextBox" 
                                                 Text="https://rpc.vitruveo.xyz"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Margin="0,0,0,12"/>

                                        <TextBlock Text="Factory Contract Address" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="FactoryAddressTextBox" 
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Margin="0,0,0,12"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Swap Router Contract Address" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="SwapRouterAddressTextBox" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Token Pair Selection Card -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="TOKEN PAIR SELECTION" Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="LpPairsComboBox"
                                              Grid.Column="0"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="LpPairsComboBox_SelectionChanged"
                                              Height="36"
                                              VerticalContentAlignment="Center"/>

                                    <Button x:Name="LoadPairsButton"
                                            Grid.Column="1"
                                            Content="🔄 Load LP Pairs"
                                            Style="{StaticResource UtilityButtonStyle}"
                                            Margin="12,0,0,0"
                                            Width="130"
                                            Click="LoadPairsButton_Click"/>
                                </Grid>

                                <!-- LP Pair Details -->
                                <GroupBox Header="LP Pair Details" 
                                          Style="{StaticResource ModernGroupBoxStyle}"
                                          Margin="0,16,0,0">
                                    <StackPanel>
                                        <!-- Basic Metrics -->
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Side -->
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Price:" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource HighlightBrush}"
                   Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" x:Name="PriceTextBlock" 
                   Text="N/A"
                   Foreground="{StaticResource PrimaryBrush}"/>
                                                </Grid>

                                                <!-- Reverse Price Ratio -->
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Reverse Ratio:" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource HighlightBrush}"
                   Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" x:Name="ReversePriceTextBlock" 
                   Text="N/A"
                   Foreground="{StaticResource YellowBrush}"/>
                                                </Grid>

                                                <!-- 24h Volume - NEW -->
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="24h Volume:" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource HighlightBrush}"
                   Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" x:Name="VolumeTextBlock" 
                   Text="N/A"
                   Foreground="{StaticResource OrangeBrush}"/>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Liquidity:" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource HighlightBrush}"
                   Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" x:Name="LiquidityTextBlock" 
                   Text="N/A"
                   Foreground="{StaticResource PrimaryBrush}"/>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Market Cap:" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource HighlightBrush}"
                   Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" x:Name="MarketCapTextBlock" 
                   Text="N/A"
                   Foreground="{StaticResource PrimaryBrush}"/>
                                                </Grid>
                                            </StackPanel>


                                            <!-- Right Side -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Token 0 Reserve:" 
                                                               FontWeight="Bold" 
                                                               Foreground="{StaticResource HighlightBrush}"
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" x:Name="Reserve0TextBlock" 
                                                               Text="N/A"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                </Grid>

                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Token 1 Reserve:" 
                                                               FontWeight="Bold" 
                                                               Foreground="{StaticResource HighlightBrush}"
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" x:Name="Reserve1TextBlock" 
                                                               Text="N/A"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Additional Token Details (Expander) -->
                                        <Expander Header="Additional Token Details" 
                                                  Margin="5,10,5,0"
                                                  BorderThickness="0"
                                                  Foreground="{StaticResource AccentBrush}">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Supply Information -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Supply Information" 
                                                               FontWeight="Bold" 
                                                               Margin="0,0,0,8" 
                                                               Foreground="{StaticResource HighlightBrush}"/>

                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Total Supply:" 
                                                                   FontWeight="Bold" 
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" x:Name="TotalSupplyTextBlock" 
                                                                   Text="N/A"/>
                                                    </Grid>

                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Circulating:" 
                                                                   FontWeight="Bold" 
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" x:Name="CirculatingSupplyTextBlock" 
                                                                   Text="N/A"/>
                                                    </Grid>

                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Holder Count:" 
                                                                   FontWeight="Bold" 
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" x:Name="HolderCountTextBlock" 
                                                                   Text="N/A"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- USD Information -->
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="USD Information" 
                                                               FontWeight="Bold" 
                                                               Margin="0,0,0,8" 
                                                               Foreground="{StaticResource HighlightBrush}"/>

                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Reserve 0 Value:" 
                                                                   FontWeight="Bold" 
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" x:Name="Reserve0UsdTextBlock" 
                                                                   Text="N/A"/>
                                                    </Grid>

                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Reserve 1 Value:" 
                                                                   FontWeight="Bold" 
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" x:Name="Reserve1UsdTextBlock" 
                                                                   Text="N/A"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Contract Addresses -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">
                                                    <TextBlock Text="Contract Addresses" 
                                                               FontWeight="Bold" 
                                                               Margin="0,0,0,8" 
                                                               Foreground="{StaticResource HighlightBrush}"/>

                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Token 0:" 
                                                                   FontWeight="Bold" 
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" x:Name="Token0AddressTextBlock" 
                                                                   Text="N/A"/>
                                                    </Grid>

                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Token 1:" 
                                                                   FontWeight="Bold" 
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" x:Name="Token1AddressTextBlock" 
                                                                   Text="N/A"/>
                                                    </Grid>

                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Pair Address:" 
                                                                   FontWeight="Bold" 
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" x:Name="PairAddressTextBlock" 
                                                                   Text="N/A"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Expander>

                                        <!-- Discord Integration -->
                                        <Border Background="#12151E" 
      BorderThickness="0,1,0,0" 
      BorderBrush="#30FFFFFF"
      Margin="0,12,0,0" 
      Padding="8,12,8,8">
                                            <StackPanel>
                                                <!-- Discord Channel Settings -->
                                                <TextBlock Text="Discord Embed Settings" 
                  Foreground="{StaticResource AccentBrush}"
                  FontWeight="SemiBold"
                  FontSize="14"
                  Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Discord Channel ID:" 
                      Style="{StaticResource LabelStyle}"
                      VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" x:Name="DiscordChannelIdTextBox" 
                    Style="{StaticResource ModernTextBoxStyle}"
                    Margin="10,0,0,0"/>
                                                </Grid>

                                                <!-- Periodic Embed Settings -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox x:Name="SendPeriodicEmbedsCheckBox" 
                     Grid.Column="0" 
                     Content="Send Periodic Embeds" 
                     Foreground="{StaticResource PrimaryBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"/>

                                                    <TextBlock Grid.Column="2" Text="Interval (min):" 
                      Style="{StaticResource LabelStyle}"
                      VerticalAlignment="Center"
                      Margin="10,0,8,0"/>

                                                    <TextBox Grid.Column="3" x:Name="EmbedIntervalTextBox" 
                    Style="{StaticResource ModernTextBoxStyle}"
                    Text="60"
                    IsEnabled="{Binding ElementName=SendPeriodicEmbedsCheckBox, Path=IsChecked}"/>
                                                </Grid>

                                                <!-- Embed Content Settings -->
                                                <Expander Header="Embed Appearance" 
                 Foreground="{StaticResource HighlightBrush}"
                 Margin="0,0,0,8">
                                                    <StackPanel Margin="0,8,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <CheckBox Grid.Row="0" Grid.Column="0" 
                             x:Name="IncludeChartCheckBox" 
                             Content="Include Chart" 
                             Foreground="{StaticResource PrimaryBrush}"
                             IsChecked="True"
                             Margin="0,0,0,8"/>

                                                            <CheckBox Grid.Row="0" Grid.Column="1" 
                             x:Name="IncludeTokenInfoCheckBox" 
                             Content="Include Token Info" 
                             Foreground="{StaticResource PrimaryBrush}"
                             IsChecked="True"
                             Margin="10,0,0,8"/>

                                                            <CheckBox Grid.Row="1" Grid.Column="0" 
                             x:Name="IncludeLiquidityInfoCheckBox" 
                             Content="Include Liquidity Info" 
                             Foreground="{StaticResource PrimaryBrush}"
                             IsChecked="True"/>

                                                            <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="Embed Color:" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource PrimaryBrush}"
                                  Margin="0,0,8,0"/>

                                                                <TextBox Grid.Column="1" x:Name="EmbedColorTextBox" 
                                Text="#50E999" 
                                Style="{StaticResource ModernTextBoxStyle}"/>
                                                            </Grid>
                                                        </Grid>
                                                    </StackPanel>
                                                </Expander>

                                                <!-- Action Buttons -->
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button x:Name="RefreshDataButton" 
                   Grid.Column="0"
                   Content="🔄 Refresh Data" 
                   Style="{StaticResource UtilityButtonStyle}"
                   Margin="0,0,4,0"
                   Click="RefreshDataButton_Click"/>

                                                    <Button x:Name="SendToDiscordButton" 
                   Grid.Column="1"
                   Content="📤 Send to Discord" 
                   Style="{StaticResource UtilityButtonStyle}"
                   Margin="4,0,0,0"
                   Click="SendToDiscordButton_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </GroupBox>

                                <!-- Manual Token Path -->
                                <TextBlock Text="Manual Token Path (comma-separated addresses)" 
                                           Style="{StaticResource LabelStyle}" 
                                           Margin="0,12,0,3"
                                           Foreground="{StaticResource OrangeBrush}"/>
                                <TextBox x:Name="PathTextBox"
                                         Text="0xInputToken,0xOutputToken"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Bot Configuration Card -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="BOT CONFIGURATION" Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Bot Nickname" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="BotNicknameTextBox"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Margin="0,0,0,12"/>
                                    </StackPanel>

                                    <!-- Right Column -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Status Type" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="StatusTypeComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"
                                                  SelectionChanged="StatusTypeComboBox_SelectionChanged"
                                                  Margin="0,0,0,12">
                                            <ComboBoxItem Content="Price" IsSelected="True"/>
                                            <ComboBoxItem Content="Reserves"/>
                                            <ComboBoxItem Content="Market Cap"/>
                                            <ComboBoxItem Content="Custom"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Custom Status" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="CustomStatusTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         IsEnabled="False"
                                         Margin="0,0,0,12"/>

                                <!-- Bot Control Buttons -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="StartButton"
                                            Grid.Column="0"
                                            Content="▶️ Start Bot"
                                            Style="{StaticResource StartButtonStyle}"
                                            Margin="0,0,6,0"
                                            Height="40"
                                            Click="StartButton_Click"/>

                                    <Button x:Name="StopButton"
                                            Grid.Column="1"
                                            Content="⏹️ Stop Bot"
                                            Style="{StaticResource StopButtonStyle}"
                                            Margin="6,0,0,0"
                                            Height="40"
                                            IsEnabled="False"
                                            Click="StopButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Logs Card -->
                        <Border Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="EXECUTION LOGS" 
                                               Style="{StaticResource SectionHeaderStyle}"
                                               VerticalAlignment="Center"/>

                                    <Border Grid.Column="1" 
                                            Background="#30FFFFFF" 
                                            Height="1" 
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"/>
                                </Grid>

                                <TextBox x:Name="LogTextBox"
                                         Style="{StaticResource LogConsoleStyle}"
                                         Height="200"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Bot Status Dashboard Tab (NEW) -->
            <TabItem Header="Bot Status" Style="{StaticResource ModernTabItemStyle}">
                <Border Style="{StaticResource CardPanelStyle}" Margin="5,10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="BOT STATUS DASHBOARD" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Column="1" 
                                    Background="#30FFFFFF" 
                                    Height="1" 
                                    Margin="12,0,12,0"
                                    VerticalAlignment="Center"/>

                            <Button x:Name="RefreshDashboardButton" Grid.Column="2"
                                    Content="🔄 Refresh" 
                                    Style="{StaticResource UtilityButtonStyle}"
                                    Click="RefreshDashboard_Click"
                                    Width="100"/>
                        </Grid>

                        <DataGrid x:Name="BotStatusGrid" 
                                  ItemsSource="{Binding BotStatuses}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderBrush="#404452"
                                  BorderThickness="1"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#20FFFFFF"
                                  VerticalGridLinesBrush="#20FFFFFF">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bot Name" Binding="{Binding BotName}" Width="*"/>
                                <DataGridTextColumn Header="Pair" Binding="{Binding PairName}" Width="*"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding CurrentPrice}" Width="*"/>
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#505050"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdated}" Width="100"/>
                                <DataGridTemplateColumn Header="Actions" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Start" Width="60" Margin="2,0" 
                                                        Style="{StaticResource StartButtonStyle}"
                                                        Click="StartBotFromDashboard_Click" 
                                                        Tag="{Binding BotId}"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverterInverted}}"/>
                                                <Button Content="Stop" Width="60" Margin="2,0" 
                                                        Style="{StaticResource StopButtonStyle}"
                                                        Click="StopBotFromDashboard_Click" 
                                                        Tag="{Binding BotId}"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="Details" Width="60" Margin="2,0" 
                                                        Style="{StaticResource UtilityButtonStyle}"
                                                        Click="ViewBotDetails_Click" 
                                                        Tag="{Binding BotId}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Multi-Bot Manager Tab -->
            <TabItem Header="Multi-Bot Manager" Style="{StaticResource ModernTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="5,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bot List Panel -->
                        <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}" Margin="0,0,12,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="BOT INSTANCES" 
                                   Style="{StaticResource SectionHeaderStyle}"
                                   VerticalAlignment="Center"/>

                                    <Border Grid.Column="1" 
                                Background="#30FFFFFF" 
                                Height="1" 
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Bot Management Buttons -->
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <!-- First row: Add/Remove buttons -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="➕ Add Bot" 
                                    Style="{StaticResource StartButtonStyle}"
                                    Margin="0,0,6,0"
                                    Click="AddBot_Click"/>

                                        <Button Grid.Column="1" Content="➖ Remove Bot" 
                                    Style="{StaticResource StopButtonStyle}"
                                    Margin="6,0,0,0"
                                    Click="RemoveBot_Click"/>
                                    </Grid>

                                    <!-- Second row: Save Settings button -->
                                    <Button x:Name="SaveMultiBotSettingsButton" 
                                Content="💾 Save Settings" 
                                Style="{StaticResource UtilityButtonStyle}"
                                Height="35"
                                Click="SaveMultiBotSettings_Click"/>
                                </StackPanel>

                                <!-- Bot List -->
                                <ListView x:Name="BotListView"
                              Style="{StaticResource ModernListViewStyle}"
                              ItemContainerStyle="{StaticResource ModernListViewItemStyle}"
                              BorderThickness="1"
                              ItemsSource="{Binding BotConfigs}"
                              SelectedItem="{Binding SelectedBotConfig}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="32">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Status Indicator -->
                                                <Border Grid.Column="0" 
                                            Width="12" 
                                            Height="12" 
                                            CornerRadius="6" 
                                            Margin="0,0,10,0" 
                                            VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#505050"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Id, Converter={StaticResource BotRunningConverter}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" 
                                                                                  Color="{StaticResource PrimaryColor}" Opacity="0.7"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <!-- Bot Name -->
                                                <TextBlock Grid.Column="1" 
                                               Text="{Binding Name}" 
                                               VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </DockPanel>
                        </Border>

                        <!-- Bot Configuration Panel -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Bot Details Form -->
                            <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="BOT CONFIGURATION" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" 
                                    Background="#30FFFFFF" 
                                    Height="1" 
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"/>

                                        <!-- Added Load Pairs Button -->
                                        <Button Grid.Column="2" 
                                    Content="🔄 Load LP Pairs"
                                    Style="{StaticResource UtilityButtonStyle}"
                                    Width="130"
                                    Click="LoadPairsButton_Click"
                                    ToolTip="Load token pairs (shared with single bot tab)"/>
                                    </Grid>

                                    <!-- Configuration Form -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Name & Update Interval -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" 
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"/>
                                        <TextBox x:Name="BotNameTextBox" Grid.Row="0" Grid.Column="1" 
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedBotConfig.Name, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,12,12"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Update Interval:" 
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"/>
                                        <Grid Grid.Row="0" Grid.Column="3" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="UpdateIntervalTextBox" Grid.Column="0"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding SelectedBotConfig.UpdateIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Grid.Column="1" Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>

                                        <!-- Row 1: Bot Token -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Bot Token:" 
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"/>
                                        <TextBox x:Name="MultiTokenTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedBotConfig.Token, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,12"/>

                                        <!-- Row 2: Guild ID & Nickname -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Guild ID:" 
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"/>
                                        <TextBox x:Name="MultiGuildIdTextBox" Grid.Row="2" Grid.Column="1" 
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedBotConfig.GuildId, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,12,12"/>

                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Nickname:" 
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"/>
                                        <TextBox x:Name="MultiNicknameTextBox" Grid.Row="2" Grid.Column="3"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedBotConfig.Nickname, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,12"/>

                                        <!-- Row 3: RPC URL -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="RPC URL:" 
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"/>
                                        <TextBox x:Name="MultiRpcUrlTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedBotConfig.RpcUrl, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,12"/>

                                        <!-- Row 4: Router Address -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Router Address:" 
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"/>
                                        <TextBox x:Name="MultiRouterTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedBotConfig.SwapRouterAddress, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,12"/>

                                        <!-- Row 5: Status Type & Custom Status -->
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Status Type:" 
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"/>
                                        <ComboBox x:Name="MultiStatusTypeCombo" Grid.Row="5" Grid.Column="1"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"
                                      SelectedValue="{Binding SelectedBotConfig.StatusType}" 
                                      Margin="0,0,12,12">
                                            <ComboBoxItem Content="Price"/>
                                            <ComboBoxItem Content="Reserves"/>
                                            <ComboBoxItem Content="Market Cap"/>
                                            <ComboBoxItem Content="Custom"/>
                                        </ComboBox>

                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="Custom Status:" 
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"/>
                                        <TextBox x:Name="MultiCustomStatusTextBox" Grid.Row="5" Grid.Column="3"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedBotConfig.CustomStatus, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding SelectedBotConfig.StatusType, Converter={StaticResource IsCustomStatusConverter}}" 
                                     Margin="0,0,0,12"/>

                                        <!-- Row 6: Token Pair -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Token Pair:" 
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"/>
                                        <Grid Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="MultiPairComboBox" Grid.Column="0"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ModernComboBoxItemStyle}"
                                          ItemsSource="{Binding Pairs}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedPair}"/>

                                            <Button Content="Use Selected Pair" Grid.Column="1"
                                        Style="{StaticResource UtilityButtonStyle}"
                                        Margin="12,0,0,0"
                                        Width="140"
                                        Click="UseSelectedPair_Click"/>
                                        </Grid>

                                        <!-- Row 7: Discord Embed Settings - IMPROVED LAYOUT -->
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Discord Settings:" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       FontSize="15"
                                       Margin="0,0,0,10"
                                       VerticalAlignment="Top"/>

                                        <Border Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" 
                                    Background="#15FFFFFF"
                                    BorderThickness="1"
                                    BorderBrush="#404452"
                                    CornerRadius="5"
                                    Padding="15"
                                    Margin="0,0,0,0">
                                            <StackPanel>
                                                <!-- Channel ID -->
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Channel ID:" 
                                                  Style="{StaticResource LabelStyle}"
                                                  VerticalAlignment="Center"/>

                                                    <TextBox Grid.Column="1"
                                                x:Name="MultiEmbedChannelIdTextBox"
                                                Style="{StaticResource ModernTextBoxStyle}"
                                                Text="{Binding SelectedBotConfig.EmbedChannelId, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>

                                                <!-- Periodic Embeds Settings -->
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" 
                                                 x:Name="MultiSendPeriodicEmbedsCheckBox" 
                                                 Content="Send Periodic Embeds" 
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 IsChecked="{Binding SelectedBotConfig.SendPeriodicEmbeds, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,15,0"/>

                                                    <TextBlock Grid.Column="2" Text="Interval (min):" 
                                                  Style="{StaticResource LabelStyle}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>

                                                    <TextBox Grid.Column="3" 
                                                x:Name="MultiEmbedIntervalTextBox" 
                                                Style="{StaticResource ModernTextBoxStyle}"
                                                Text="{Binding SelectedBotConfig.EmbedIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding ElementName=MultiSendPeriodicEmbedsCheckBox, Path=IsChecked}"/>
                                                </Grid>

                                                <!-- Content Options -->
                                                <TextBlock Text="Embed Content Options" 
                                              Foreground="{StaticResource HighlightBrush}"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,10"/>

                                                <Grid Margin="5,0,5,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" 
                                                 x:Name="MultiIncludeChartCheckBox" 
                                                 Content="Include Chart" 
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 IsChecked="{Binding SelectedBotConfig.IncludeChartInEmbed, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,10,0"/>

                                                    <CheckBox Grid.Column="1" 
                                                 x:Name="MultiIncludeTokenInfoCheckBox" 
                                                 Content="Include Token Info" 
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 IsChecked="{Binding SelectedBotConfig.IncludeTokenInfoInEmbed, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="10,0,10,0"/>

                                                    <CheckBox Grid.Column="2" 
                                                 x:Name="MultiIncludeLiquidityInfoCheckBox" 
                                                 Content="Include Liquidity Info" 
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 IsChecked="{Binding SelectedBotConfig.IncludeLiquidityInfoInEmbed, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="10,0,0,0"/>
                                                </Grid>

                                                <!-- Embed Color -->
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Embed Color:" 
                                                  Style="{StaticResource LabelStyle}"
                                                  VerticalAlignment="Center"/>

                                                    <TextBox Grid.Column="1" x:Name="MultiEmbedColorTextBox" 
                                                Text="{Binding SelectedBotConfig.EmbedColor, UpdateSourceTrigger=PropertyChanged}" 
                                                Style="{StaticResource ModernTextBoxStyle}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Enhanced Logs Panel -->
                            <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Margin="0,12,0,12">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="EXECUTION LOGS" 
                                       Style="{StaticResource SectionHeaderStyle}"
                                       VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" 
                                    Background="#30FFFFFF" 
                                    Height="1" 
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid>
                                        <TextBox x:Name="MultiLogTextBox"
                                     Style="{StaticResource LogConsoleStyle}"
                                     MinHeight="240"/>

                                        <!-- Timestamp indicator in the corner of the log console -->
                                        <Border Background="#20000000" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top"
                                    Padding="8,3"
                                    CornerRadius="0,0,0,5"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="#404452">
                                            <TextBlock Text="Live Updates" 
                                           Foreground="{StaticResource PrimaryBrush}" 
                                           FontSize="11"
                                           FontStyle="Italic"/>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <!-- Bot Controls Panel -->
                            <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Margin="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                   Text="Control the selected bot instance" 
                                   Foreground="{StaticResource HighlightBrush}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="StartSelectedBotButton" 
                                    Content="▶️ Start Bot" 
                                    Style="{StaticResource StartButtonStyle}"
                                    Width="140" 
                                    Height="40"
                                    Margin="0,0,12,0"
                                    Click="StartSelectedBot_Click"/>

                                        <Button x:Name="StopSelectedBotButton" 
                                    Content="⏹️ Stop Bot" 
                                    Style="{StaticResource StopButtonStyle}"
                                    Width="140"
                                    Height="40"
                                    Margin="0,0,12,0"
                                    Click="StopSelectedBot_Click"/>

                                        <Button x:Name="StopAllBotsButton" 
                                    Content="⏹️ Stop All Bots" 
                                    Style="{StaticResource StopButtonStyle}"
                                    Width="140"
                                    Height="40"
                                    Click="StopAllBots_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
