<!-- SettingsWindow.xaml -->
<Window x:Class="RadXPriceBot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="300" Width="400"
        Background="{StaticResource PanelBgBrush}"
        Foreground="{StaticResource PrimaryBrush}"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Discord Bot Token:"/>
                <TextBox x:Name="BotTokenTextBox" Margin="0,4,0,10"/>

                <TextBlock Text="Guild ID:"/>
                <TextBox x:Name="GuildIdTextBox" Margin="0,4,0,10"/>

                <TextBlock Text="RPC Endpoint URL:"/>
                <TextBox x:Name="RpcUrlTextBox" Margin="0,4,0,10"/>

                <TextBlock Text="Swap Router Address:"/>
                <TextBox x:Name="SwapRouterAddressTextBox" Margin="0,4,0,10"/>

                <TextBlock Text="Factory Address:"/>
                <TextBox x:Name="FactoryAddressTextBox" Margin="0,4,0,10"/>

                <TextBlock Text="Bot Nickname:"/>
                <TextBox x:Name="BotNicknameTextBox" Margin="0,4,0,10"/>

                <TextBlock Text="Default Status:"/>
                <ComboBox x:Name="StatusTypeComboBox" Margin="0,4,0,10">
                    <ComboBoxItem Content="Price"/>
                    <ComboBoxItem Content="Reserves"/>
                    <ComboBoxItem Content="Market Cap"/>
                    <ComboBoxItem Content="Custom"/>
                </ComboBox>

                <TextBlock Text="Custom Status:"/>
                <TextBox x:Name="CustomStatusTextBox" Margin="0,4,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Width="80" Click="SaveButton_Click" Margin="0,0,10,0"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
